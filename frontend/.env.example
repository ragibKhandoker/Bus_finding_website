VITE_API_BASE_URL=http://localhost:3000

# Google Maps browser key for the interactive map (Maps JavaScript API only).
# Restrict it in Google Cloud to your site's addresses (HTTP referrers), e.g. http://localhost:5173/* and your deployed URL.
# It is visible to anyone who opens the site, which is why the restriction matters. Distances use a separate
# server key that stays on the backend (GoogleMaps:ServerApiKey).
VITE_GOOGLE_MAPS_API_KEY=
# Optional map ID from Google Cloud (Map Management). Without it Google's DEMO_MAP_ID is used, which is for development.
VITE_GOOGLE_MAPS_MAP_ID=
